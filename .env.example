# Required, free (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free stock footage: https://www.pexels.com/api/ (without it, videos use plain backgrounds)
PEXELS_API_KEY=

# Free trend data from YouTube: Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key
YT_API_KEY=

# Optional
# ACG_MODEL=gemini-flash-latest
# ACG_VOICE=en-US-AndrewNeural
# YT_CATEGORY_ID=22
