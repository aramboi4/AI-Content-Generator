# Required, free (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free AI 3D images (Cloudflare Workers AI free daily allowance) - see README "AI images setup"
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Free stock footage (used when Cloudflare isn't set up, or as fallback): https://pixabay.com/api/docs/ (sign up, key is shown on that page)
# Without it, videos use plain backgrounds.
PIXABAY_API_KEY=
# Alternative footage source (new Pexels keys are paused as of Oct 2026)
PEXELS_API_KEY=

# Free trend data from YouTube: Google Cloud console -> enable "YouTube Data API v3" -> Credentials -> API key
YT_API_KEY=

# Voice: Inworld's Clive or Dennis (random). Free plan has limited minutes; when they run out the
# free Kokoro voice (am_adam) is used. Key from https://platform.inworld.ai -> API Keys (copy the Base64 key).
INWORLD_API_KEY=

# Phone delivery: each video + captions sent to you on Telegram (see README "Phone delivery")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
# ACG_MODEL=gemini-flash-latest
# ACG_WEB_SEARCH=1   # only if your Gemini key includes Google Search grounding (not on the free tier)
# ACG_VOICE=en-US-AndrewNeural
# YT_CATEGORY_ID=22
# ACG_CUSTOM_THUMBNAIL=1   # set a custom YouTube thumbnail with the title (turn on once monetized)
